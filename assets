<svg xmlns="http://www.w3.org/2000/svg" width="1180" height="650" viewBox="0 0 1180 650">
<defs>
  <linearGradient id="bg" x1="0" y1="0" x2="1" y2="1">
    <stop offset="0" stop-color="#030712"/>
    <stop offset=".48" stop-color="#0b1020"/>
    <stop offset="1" stop-color="#030712"/>
  </linearGradient>

  <linearGradient id="asciiGradient" x1="0%" y1="0%" x2="100%" y2="0%">
    <stop offset="0%" stop-color="#7C3AED"/>
    <stop offset="48%" stop-color="#22D3EE"/>
    <stop offset="100%" stop-color="#10B981"/>
    <animate attributeName="x1" values="0%;100%;0%" dur="7s" repeatCount="indefinite"/>
    <animate attributeName="x2" values="100%;0%;100%" dur="7s" repeatCount="indefinite"/>
  </linearGradient>

  <radialGradient id="glow" cx="50%" cy="45%" r="60%">
    <stop offset="0%" stop-color="#22D3EE" stop-opacity=".18"/>
    <stop offset="45%" stop-color="#7C3AED" stop-opacity=".10"/>
    <stop offset="100%" stop-color="#030712" stop-opacity="0"/>
  </radialGradient>

  <filter id="softGlow" x="-30%" y="-30%" width="160%" height="160%">
    <feGaussianBlur stdDeviation="2.6" result="blur"/>
    <feMerge>
      <feMergeNode in="blur"/>
      <feMergeNode in="SourceGraphic"/>
    </feMerge>
  </filter>

  <filter id="textGlow" x="-20%" y="-20%" width="140%" height="140%">
    <feGaussianBlur stdDeviation="1.15" result="b"/>
    <feMerge>
      <feMergeNode in="b"/>
      <feMergeNode in="SourceGraphic"/>
    </feMerge>
  </filter>

  <clipPath id="panelClip">
    <rect x="0" y="0" width="1180" height="650" rx="28"/>
  </clipPath>

  <pattern id="noise" width="4" height="4" patternUnits="userSpaceOnUse">
    <circle cx="1" cy="1" r=".45" fill="#fff" opacity=".035"/>
    <circle cx="3" cy="3" r=".35" fill="#fff" opacity=".025"/>
  </pattern>
</defs>

<style>
  .ascii {
    font-family: "Courier New", "Consolas", monospace;
    font-size: 7.2px;
    font-weight: 700;
    letter-spacing: .35px;
    fill: url(#asciiGradient);
    opacity: 0;
    filter: url(#textGlow);
    animation: reveal 5.8s cubic-bezier(.2,.7,.2,1) forwards;
    animation-delay: calc(var(--i) * 42ms);
  }

  @keyframes reveal {
    0% { opacity: 0; transform: translateY(4px); }
    55% { opacity: .65; }
    100% { opacity: 1; transform: translateY(0); }
  }

  .blink {
    animation: blink 1s steps(2,end) infinite;
  }

  @keyframes blink {
    0%, 48% { opacity: 1; }
    49%, 100% { opacity: 0; }
  }

  .float {
    animation: float 6s ease-in-out infinite;
    transform-origin: center;
  }

  @keyframes float {
    0%,100% { transform: translateY(0); }
    50% { transform: translateY(-5px); }
  }

  .scan {
    animation: scan 4.5s linear infinite;
  }

  @keyframes scan {
    0% { transform: translateY(-40px); opacity: 0; }
    12% { opacity: .35; }
    50% { opacity: .15; }
    100% { transform: translateY(690px); opacity: 0; }
  }

  .pulse {
    animation: pulse 2.8s ease-in-out infinite;
  }

  @keyframes pulse {
    0%,100% { opacity: .18; }
    50% { opacity: .34; }
  }
</style>

